<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">CineMoy</string>

    <color name="bg">#110C1B</color>
    <color name="violet">#2A1745</color>
    <color name="coral">#FF6F61</color>

    <style name="Theme.CineMoy" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/coral</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <style name="Theme.CineMoy.Player" parent="Theme.CineMoy">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.CineMoy.Restart" parent="android:Theme.Translucent.NoTitleBar" />

    <style name="PlayerButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/player_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
