<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app updates: installs a newer CineMoy APK from the GitHub release. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- One APK for phones, tablets and Android TV. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.CineMoy">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PlayerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.CineMoy.Player" />

        <!-- Restarts the app in a fresh process when the engine stops. -->
        <activity
            android:name=".RestartActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:process=":restart"
            android:theme="@style/Theme.CineMoy.Restart" />

        <provider
            android:name=".ApkProvider"
            android:authorities="app.cinemoy.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
